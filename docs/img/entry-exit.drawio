<mxfile host="app.diagrams.net" agent="DocSentinel docs">
  <diagram id="entry-exit" name="Entry and exit points">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Column titles -->
        <mxCell id="t_in" value="&lt;b&gt;IN&lt;/b&gt;: who starts a run" style="text;html=1;align=center;fontSize=15;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t_core" value="&lt;b&gt;DocSentinel&lt;/b&gt;" style="text;html=1;align=center;fontSize=15;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="420" y="20" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t_out" value="&lt;b&gt;OUT&lt;/b&gt;: where results go" style="text;html=1;align=center;fontSize=15;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1060" y="20" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- Entry points -->
        <mxCell id="in_gh" value="&lt;b&gt;GitHub PR / push&lt;/b&gt;&lt;br&gt;reusable workflows&lt;br&gt;(check / fix)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="in_cli" value="&lt;b&gt;CLI&lt;/b&gt; on any git repo&lt;br&gt;flag · fix · ask · trial · eval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="in_mcp" value="&lt;b&gt;AI editor&lt;/b&gt; via MCP&lt;br&gt;Claude Code · Cursor · VS Code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Trust zones -->
        <mxCell id="z_llm" value="&lt;b&gt;LLM zone: read-only&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="320" height="500" as="geometry" />
        </mxCell>
        <mxCell id="z_write" value="&lt;b&gt;Write zone: no LLM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="70" width="220" height="500" as="geometry" />
        </mxCell>

        <!-- Inside LLM zone -->
        <mxCell id="analyze" value="&lt;b&gt;analyze job&lt;/b&gt;&lt;br&gt;Scout → Mapper → Judge&lt;br&gt;→ Fixer → Verifier + Reviewer&lt;br&gt;&lt;i&gt;token: contents read only&lt;/i&gt;&lt;br&gt;&lt;i&gt;PR code parsed, never run&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="local" value="&lt;b&gt;local run&lt;/b&gt;&lt;br&gt;results → files in out/ (optional --webhook)&lt;br&gt;writes to git only with --branch / --pr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="300" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mcp" value="&lt;b&gt;MCP server&lt;/b&gt; (stdio, local)&lt;br&gt;tools: ask_docs, check_docs&lt;br&gt;&lt;i&gt;read-only&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="470" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- LLM -->
        <mxCell id="llm" value="&lt;b&gt;claude -p&lt;/b&gt;&lt;br&gt;no tools, or read-only&lt;br&gt;Read/Grep/Glob (not sandboxed)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="620" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k_claude" value="🔑 CLAUDE_KEY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="645" width="130" height="30" as="geometry" />
        </mxCell>

        <!-- Inside write zone -->
        <mxCell id="write" value="&lt;b&gt;comment / open-pr jobs&lt;/b&gt;&lt;br&gt;the only jobs that write&lt;br&gt;&lt;i&gt;draft PRs only on&lt;br&gt;docs-sentinel/* branches;&lt;br&gt;never merges&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="100" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="artifact" value="artifact:&lt;br&gt;report.json · fix.patch" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="260" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Exit points -->
        <mxCell id="out_pr" value="&lt;b&gt;PR comment + draft docs PR&lt;/b&gt;&lt;br&gt;a human reviews and merges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="90" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="k_gh" value="🔑 GITHUB_TOKEN (write job only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="155" width="260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="out_slack" value="&lt;b&gt;Slack&lt;/b&gt;&lt;br&gt;counts + links only, never doc text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="215" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="k_slack" value="🔑 SLACK_WEBHOOK_URL (the URL is the credential; never logged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="280" width="260" height="36" as="geometry" />
        </mxCell>
        <mxCell id="out_hook" value="&lt;b&gt;Signed webhook&lt;/b&gt; (any HTTPS service)&lt;br&gt;HMAC-SHA256, 5-min replay window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="350" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="k_hook" value="🔑 DOCSENTINEL_WEBHOOK_SECRET" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="415" width="260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="out_answer" value="&lt;b&gt;Answer in the editor&lt;/b&gt;&lt;br&gt;cited, warns about stale docs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="475" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- Install/tool access note -->
        <mxCell id="note" value="&lt;b&gt;Running now:&lt;/b&gt; this repo checks out its own pinned commit with github.token. Config is read from the base branch; fork / Dependabot PRs get no secrets → rules only; kill switch DOCSENTINEL_ENABLED=false.&lt;br&gt;&lt;b&gt;Recommended deployment for other private repos (not running in this demo):&lt;/b&gt; a GitHub App installation token, or 🔑 DOCSENTINEL_READ_TOKEN (fine-grained, Contents: read) to check out the private tool." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;size=14;" vertex="1" parent="1">
          <mxGeometry x="860" y="610" width="500" height="110" as="geometry" />
        </mxCell>

        <!-- Edges: entry -> core -->
        <mxCell id="e1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="in_gh" target="analyze">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="in_cli" target="local">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="in_mcp" target="mcp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- core -> LLM -->
        <mxCell id="e4" style="endArrow=block;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="analyze" target="llm">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="410" y="155" /><mxPoint x="410" y="665" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="mcp" target="llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5b" style="endArrow=none;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="llm" target="k_claude">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- analyze -> artifact -> write -->
        <mxCell id="e6" value="artifact only" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="analyze" target="artifact">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="artifact" target="write">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- write -> exits -->
        <mxCell id="e8" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="write" target="out_pr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="write" target="out_slack">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;" edge="1" parent="1" source="write" target="out_hook">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1030" y="202" /><mxPoint x="1030" y="380" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="mcp" target="out_answer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
